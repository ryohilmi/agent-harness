{
  "name": "agent-harness",
  "version": "0.1.0",
  "description": "Minimal agent harness for any OpenAI-compatible chat completions API",
  "private": true,
  "type": "module",
  "bin": {
    "agent-harness": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
