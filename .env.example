# Copy this file to .env and fill in your own values.
# .env is gitignored, so secrets never get committed.

# API key. Leave empty for local endpoints that need no auth.
OPENAI_API_KEY=

# OpenAI-compatible chat completions endpoint.
OPENAI_BASE_URL=https://api.vikey.ai/v1/chat/completions

# Model name as expected by the endpoint.
OPENAI_MODEL=gpt-4o-mini

# Optional tuning.
AGENT_MAX_TURNS=8
OPENAI_TIMEOUT=60

# Bash tool: default timeout (seconds) and stdout+stderr byte cap.
AGENT_BASH_TIMEOUT=120
AGENT_MAX_OUTPUT_BYTES=100000

# File tools: directory the model may read and write (default: current dir).
# AGENT_ROOT=/path/to/project
AGENT_MAX_READ_LINES=2000
AGENT_MAX_READ_BYTES=1000000

# Safety.
# yolo mode runs tool calls without asking for approval. Never enable it in
# a directory where you would not hand a stranger a shell.
AGENT_YOLO=0
# Block reads of .env/private keys/credential stores, and strip
# credential-looking variables from the bash environment.
AGENT_PROTECT_SECRETS=1
# Names that must still reach bash despite the scrub (comma separated).
# AGENT_BASH_ENV_ALLOW=GH_TOKEN,NPM_TOKEN
